<!-- Printer with Date + RendererErr + PreProcessorToLower -->
<bean id="rendererErrLower" class="edu.school.context.renderer.RendererErrImpl">
    <constructor-arg ref="preProcessorLower"/>
</bean>

<bean id="printerDateErrLower" class="edu.school.context.printer.PrinterWithDateTimeImpl">
    <constructor-arg ref="rendererErrLower"/>
</bean>


<!-- Printer with Date + RendererOut + PreProcessorUpper -->
<bean id="rendererOutUpper" class="edu.school.context.renderer.RendererStandardImpl">
    <constructor-arg ref="preProcessorUpper"/>
</bean>

<bean id="printerDateOutUpper" class="edu.school.context.printer.PrinterWithDateTimeImpl">
    <constructor-arg ref="rendererOutUpper"/>
</bean>
